.env
.env.*
.envrc
.venv/
venv/
ENV/
*.secret
secrets.*
.pypirc

# --- Artefacts generes (jamais de donnees de test dans le repo) ---
smoke_out.json
*.log

# --- Deploiement Cloudflare (etat local) ---
.wrangler/
node_modules/

